        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations recorded yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はまだありません。"
          }
        }
      }
    },
    "OperationError": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료하지 못했습니다. 작업 기록에서 결과를 확인한 뒤 다시 검사해 보세요. 문제가 반복되면 도움말 → 진단 보고서 내보내기를 이용할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not finish. Check History and local diagnostic logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理を完了できませんでした。履歴と診断ログを確認してください。"
          }
        }
      }
    },
    "Cancelled": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사를 취소했습니다. 완료된 항목만 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan canceled. Partial results are shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンをキャンセルしました。ここまでにスキャンした項目を表示します。"
          }
        }
      }
    },
    "ScanLimit": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 한도인 200,000개에 도달했습니다. 폴더를 나누어 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety limit of 200,000 items was reached. Scan smaller folders separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全のための上限（20万件）に達しました。フォルダを分けてスキャンしてください。"
          }
        }
      }
    },
    "SettingsWarning": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 읽을 수 없어 기본값을 사용합니다. 원본 설정 파일은 보존됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be loaded. Safe defaults are active; the original file is preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めないため、デフォルトの設定を使用します。元の設定ファイルはそのまま残しています。"
          }
        }
      }
    },
    "CancelBeforeClose": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 작업을 중단하고 종료하는 중입니다…"
