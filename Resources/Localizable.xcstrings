    "AboutFeatures": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자소 분리된 파일 이름을 정리하고, 규칙으로 여러 파일 이름을 한 번에 바꿉니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes filenames that look broken on other devices and renames many files at once with rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "濁点・半濁点などが分かれたファイル名の文字を整え、ルールで複数のファイル名をまとめて変更します。"
          }
        }
      }
    },
    "AboutFree": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능이 무료이며, 기능 잠금이나 사용 기간·횟수 제한이 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every feature is free, with no locked features and no time or usage limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能が無料で、機能のロックや利用期間・回数の制限はありません。"
          }
        }
      }
    },
    "AboutPrivate": {
      "extractionState": "manual",
