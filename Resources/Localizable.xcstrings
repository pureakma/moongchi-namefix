      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 변경을 감지해 중단했습니다. 항목이 임시 이름에 남아 있을 수 있습니다. 작업 기록의 복구 위치를 확인하세요."
          }
