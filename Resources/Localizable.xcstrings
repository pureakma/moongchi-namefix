    "PairExtensions": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 쌍 확장자 (Pro, 예: jpg,raw,xmp)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired extensions (Pro, e.g. jpg,raw,xmp)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアの拡張子（Pro、例: jpg,raw,xmp）"
          }
        }
      }
    },
    "PairHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 폴더·동일한 이름의 파일에 같은 새 이름과 순번을 적용하고 확장자는 보존합니다. 이름 본문 규칙만 사용하며 CSV 매핑과 함께 사용할 수 없습니다. 일부 선택·충돌·오류가 있으면 그룹을 제외합니다. 부분 실패는 기록에서 복구합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files with the same stem in one folder share the new stem and number, preserving extensions. Use stem rules only; CSV mapping is incompatible. Incomplete selections, conflicts or errors exclude the group. Recover partial failures in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じフォルダで名前本体が同じファイルに同じ名前と連番を適用し、拡張子を保持します。本体の規則のみ使用でき、CSVとは併用できません。一部選択・競合・エラーはグループを除外します。部分失敗は履歴から復旧します。"
          }
        }
      }
    },
    "PairAmbiguous": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 쌍 일부가 모호하거나 충돌합니다. 전체 그룹을 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file pair is ambiguous or conflicting. Review the whole group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアの一部が曖昧または競合しています。グループ全体を確認してください。"
          }
        }
      }
    },
