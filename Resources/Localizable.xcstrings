    "HelpStepAddDetail": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창에 끌어다 놓거나 파일 선택·폴더 선택을 누릅니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
