      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 폴더 자체와 그 안의 하위 폴더 이름에도 규칙을 적용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules also apply to the folders you added and to the subfolders inside them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したフォルダ自体と、その中のサブフォルダの名前にもルールを適用します。"
          }
        }
      }
    },
    "IncludeHidden": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨김 파일 포함"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include hidden files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のファイルを含める"
          }
        }
      }
    },
    "IncludeHiddenHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 점(.)으로 시작하는 항목과 그런 폴더 안의 항목에도 규칙을 적용합니다. .DS_Store 같은 Finder 관리 파일은 항상 제외합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules also apply to items whose names start with a dot and to items inside such folders. Finder’s own files such as .DS_Store are always skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前がドット（.）で始まる項目と、そうしたフォルダの中にある項目にもルールを適用します。.DS_Storeなど、Finderが管理するファイルは常に除外します。"
          }
        }
      }
    },
    "NotTarget": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 아님"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not included"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象外"
          }
        }
      }
    },
    "FolderExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 이름은 일괄 변경의 기본 대상이 아닙니다. 규칙 추가 → 고급 → 대상 범위에서 ‘폴더 이름도 변경’을 켤 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder names are not renamed by default. Turn on “Also rename folders” under Add Rule → Advanced → What to rename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ名は、デフォルトでは一括変更の対象外です。「ルールを追加」>「詳細」>「変更する対象」で「フォルダ名も変更」をオンにできます。"
          }
        }
      }
    },
    "HiddenExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨김 항목은 일괄 변경의 기본 대상이 아닙니다. 규칙 추가 → 고급 → 대상 범위에서 ‘숨김 파일 포함’을 켤 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden items are not renamed by default. Turn on “Include hidden files” under Add Rule → Advanced → What to rename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の項目は、デフォルトでは一括変更の対象外です。「ルールを追加」>「詳細」>「変更する対象」で「非表示のファイルを含める」をオンにできます。"
          }
        }
      }
    },
