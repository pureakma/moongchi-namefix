    "SourceChangedAfterMove": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 변경을 감지해 중단했습니다. 항목이 임시 이름에 남아 있을 수 있습니다. 작업 기록의 복구 위치를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped after detecting an external change. An item may remain at a temporary name. Review recovery locations in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリによる変更を検出して停止しました。一時名の項目が残っている場合があります。履歴の復旧場所を確認してください。"
          }
