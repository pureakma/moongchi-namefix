    "WatchHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경된 파일을 검토 대기열에 넣습니다. 자동 변경은 하지 않습니다. 검토 후 미리보기·명시 확인을 거칩니다. 처리 기록을 복원하여 재시작 후에도 같은 파일을 반복 제안하지 않습니다. 규칙을 갱신하면 전체를 재검토합니다. 감시 폴더와 하위 폴더의 이름은 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed files enter a review queue; nothing is renamed automatically. Preview and confirmation are required. Processed files are remembered across restarts. Updating rules triggers a full review. Watched folders and subfolders are never renamed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更ファイルは確認待ちになります。自動変更はなく、プレビューと明示確認が必要です。処理済みは再起動後も記憶します。規則更新で全体を再確認します。監視フォルダとサブフォルダの名前は変更しません。"
          }
        }
      }
    },
    "WatchAdd": {
      "extractionState": "manual",
      "localizations": {
