    "WatchReauthorize": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 접근 권한이 만료되었거나 폴더 위치가 바뀌었습니다. 이 감시 폴더를 제거한 뒤 다시 추가하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder access expired or its location changed. Remove this entry and select the folder again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダへのアクセス権が無効になったか、フォルダの場所が変わりました。この項目を削除して、フォルダを選び直してください。"
          }
        }
      }
    },
    "WatchReadOnly": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감시 설정을 읽거나 저장할 수 없습니다. 기존 파일을 보존했습니다."
          }
        },
        "en": {
