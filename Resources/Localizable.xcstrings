    "RecoveryNeedsReview": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 작업의 상태를 확인해야 합니다. 파일과 기록은 보존되었습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous operation needs review. Files and records have been preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の作業状態を確認する必要があります。ファイルと記録は保持されています。"
          }
        }
      }
    },
    "CanonicalVariant": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "● 다른 문자 구성"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "● Alternate form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "● 異なる構成"
          }
        }
      }
    },
    "NormalizationNotice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모양은 같아도 문자 구성이 다를 수 있습니다. 분해형은 오류가 아니며 조합형(NFC)으로 통일할 수 있습니다. 작은 칸은 실제 이름이 아닌 문자 구성 설명입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can look identical while their characters differ. Decomposed names are not errors; you can normalize them to NFC. Small boxes explain the characters, not the literal name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ見た目でも文字構成が異なることがあります。分解形はエラーではなく、NFCに統一できます。小さな枠は実際の名前ではなく文字構成の説明です。"
          }
        }
      }
    },
    "CompositionTitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 문자 구성 비교"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full character comparison"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字構成を比較"
          }
        }
      }
    },
    "CompositionLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 칸은 내부 문자를 풀어 쓴 설명입니다. 파일명 자체에 공백이나 구분 기호를 추가하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boxes explain individual characters. No spaces or separators are added to the actual filename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠は内部の文字を分けた説明です。実際のファイル名に空白や区切り文字は追加しません。"
          }
        }
      }
    },
    "CompositionScalarLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자모는 읽기 쉬운 독립 모양으로, 결합 부호는 점선 원과 함께 표시합니다. U+ 코드는 실제 문자의 값입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangul jamo use standalone display glyphs; combining marks use a dotted circle. U+ codes identify the actual characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハングル字母は独立した形、結合記号は点線の丸と表示します。U+コードは実際の文字の値です。"
          }
        }
      }
    },
    "MoreCharacterChanges": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 {0}개 글자도 달라집니다. 상세 보기에서 전체 구성을 확인하세요."
