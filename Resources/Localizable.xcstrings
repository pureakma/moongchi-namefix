    "NewerSchema": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 최신 버전의 데이터입니다. 원본을 보존하고 변경을 제한합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
