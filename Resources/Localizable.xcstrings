    "VolumeNormalizationUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac OS 확장(HFS+) 디스크는 모든 이름을 풀어진 글자로 저장해서 합친 이름이 유지되지 않습니다. 이 디스크의 항목은 이름을 바꾸지 않습니다. 파일에 문제가 있는 것은 아닙니다. Mac의 디스크나 APFS 드라이브로 복사하면 정리할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac OS Extended (HFS+) disks always store names with their characters split, so a fixed name would not stay fixed. Items on this disk are not renamed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac OS拡張（HFS+）のディスクは、すべての名前を文字が分かれた形で保存するため、1文字にまとめた名前を保てません。このディスクにある項目の名前は変更しません。"
          }
        }
      }
    },
    "VolumeSafetyUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위치에서 안전한 이름 변경을 확인할 수 없어 제외했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location was skipped because safe renaming could not be verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所では名前を安全に変更できることを確認できないため、対象から外しました。"
          }
        }
      }
    },
    "PackageExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱·패키지와 .git 폴더는 안의 이름이 바뀌면 동작하지 않을 수 있어 검사에서 제외합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, packages, and .git folders are skipped, because renaming what is inside them can break them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ、パッケージ、.gitフォルダは、中の名前が変わると動作しなくなることがあるため、スキャンの対象外です。"
          }
        }
      }
    },
    "MountBoundaryExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 디스크(볼륨) 안은 자동으로 검사하지 않습니다. 필요하면 직접 추가하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other disks found inside a folder are not scanned automatically. To scan one, add the disk itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のディスク（ボリューム）の中は、自動ではスキャンしません。必要な場合は、そのディスクを追加してください。"
          }
        }
      }
    },
    "SourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 후 항목이 변경되어 제외했습니다. 다시 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item changed after scanning and was skipped. Scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンのあとに項目が変更されたため、除外しました。再スキャンしてください。"
          }
        }
      }
    },
    "SettingsSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장하지 못했습니다. 바꾼 설정은 앱을 종료하면 유지되지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be saved. Changes apply only to this session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存できませんでした。変更は今回の起動中のみ適用されます。"
          }
        }
      }
    },
    "NewerSchema": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 새로운 버전의 앱에서 만든 데이터입니다. 원본은 그대로 두며, 이 버전에서는 변경 내용을 저장하거나 가져올 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data was created by a newer version. The original is preserved and changes are restricted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンで作成されたデータです。元のデータを保護するため変更を制限します。"
          }
        }
      }
    },
    "BusyDropRejected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중에는 항목을 추가하거나 다른 작업을 시작할 수 없습니다. 진행 중인 작업이 끝난 뒤 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items cannot be added during this operation. Drop them again when it finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中は項目を追加できません。完了してから、もう一度ドロップしてください。"
          }
        }
      }
    },
    "SameAppearanceDifferentUnicode": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모양은 같지만 저장된 글자 구성이 다릅니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These names look the same but store their characters differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目が同じでも、文字の表し方が異なります。"
          }
        }
      }
    },
    "ClipboardTruncated": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자가 너무 많아 앞부분만 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is too long, so only the first part is shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調べられる長さを超えているため、一部だけを表示しています。"
          }
        }
      }
    },
    "FinderServiceTitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NameFix로 파일 이름 검사"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Names with NameFix"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NameFixでファイル名をスキャン"
          }
        }
      }
    },
    "JournalWriteFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 기록을 저장하지 못해 이름 변경을 중단했습니다. 디스크 여유 공간을 확인한 뒤 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming stopped because the operation record could not be saved. Check free disk space and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を保存できなかったため、名前の変更を中止しました。ディスクの空き領域を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "RecoveryNeedsReview": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 작업의 상태를 확인해야 합니다. 파일과 기록은 보존되었습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous operation needs review. Files and records have been preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の操作の状態を確認する必要があります。ファイルと履歴はそのまま残っています。"
          }
        }
      }
    },
    "CanonicalVariant": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "● 글자 구성 다름"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "● Stored differently"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "● 表し方が異なる"
          }
        }
      }
    },
    "NormalizationNotice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모양은 같아도 저장된 글자 구성이 다를 수 있습니다. 글자가 분리 저장된 이름은 오류가 아니며, 하나로 합쳐 통일할 수 있습니다. 작은 칸은 실제 이름이 아니라 글자 구성을 풀어 보여 주는 설명입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A character such as é can be stored whole or in pieces (an e plus a separate accent). Both look the same on your Mac, but other devices and apps may show the pieces apart or treat the two names as different. Nothing is wrong with the file, and fixing combines the pieces into one character. The small boxes in the list show the pieces; they are not part of the name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目が同じ文字でも、表し方が2通りある場合があります。たとえば「が」は、1文字として保存される場合と、「か」と濁点に分かれて保存される場合があります。分かれたままほかの環境とやり取りすると、濁点・半濁点が離れて見えたり、検索や並び順が合わなくなったりすることがあります。分かれている名前はエラーではなく、1文字にまとめてそろえられます。一覧の小さな枠は実際の名前の一部ではなく、文字の構成を示す説明です。"
          }
        }
      }
    },
    "CompositionTitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 글자 구성 비교"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full character comparison"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字ごとの比較"
          }
        }
      }
    },
    "CompositionLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 칸은 내부 문자를 풀어 쓴 설명입니다. 파일 이름 자체에는 공백이나 구분 기호를 추가하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boxes explain individual characters. No spaces or separators are added to the actual filename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠は、文字の構成を1つずつ示した説明です。実際のファイル名に空白や区切り文字を加えることはありません。"
          }
        }
      }
    },
    "CompositionScalarLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자모는 읽기 쉬운 낱자 모양으로, 결합 부호는 점선 원과 함께 표시합니다. U+로 시작하는 값은 실제 문자의 코드입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combining marks are shown on a dotted circle, and Hangul letters as standalone shapes. Values starting with U+ are the actual character codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "濁点・半濁点やアクセントなどの結合文字は点線の丸と一緒に、ハングルの字母は単独の形で表示します。U+で始まる値は、その文字のコードです。"
          }
        }
      }
    },
    "MoreCharacterChanges": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 {0}개 글자도 달라집니다. 자세히 보기에서 전체 구성을 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} more characters change. Open Character Details for the full comparison."
