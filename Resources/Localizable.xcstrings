        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りフォルダを開けません"
          }
        }
      }
    },
    "RecentUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 찾을 수 없어 최근 폴더 목록에서 뺐습니다."
          }
        },
        "en": {
