    "SafeExportHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프레드시트에서 안전하게 열 수 있도록, 수식으로 해석될 수 있는 칸 앞에 작은따옴표를 붙여 저장합니다. 정확한 원본 이름은 별도 열(base64)에 함께 보존합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To open safely in spreadsheet apps, cells that could be read as formulas are saved with a leading apostrophe. The exact original names are kept in separate base64 columns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表計算アプリで安全に開けるよう、数式として解釈される可能性のあるセルの先頭にアポストロフィを付けて保存します。正確な元の名前は別の列（base64）に保持します。"
          }
        }
      }
    },
    "RawExportHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 CSV는 이름을 그대로 저장합니다. 스프레드시트에서 열면 수식처럼 해석될 수 있으므로 텍스트로 가져오세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw CSV preserves names exactly. Import it as text in spreadsheet apps to avoid formula interpretation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の文字をそのまま保存します。数式として解釈されないよう、表計算アプリにはテキストとして読み込んでください。"
          }
        }
      }
    },
    "ExportFailed": {
