    "FormatIntro": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자소 분리, 일본어 탁점·반탁점, 악센트가 있는 문자 등 이름의 문자 구성을 정리합니다. 겉모양이 같아도 저장된 구성은 다를 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine separated Hangul letters, Japanese voicing marks, and accented characters in names. Names can look identical while storing characters differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハングルの字母や、日本語の濁点・半濁点、アクセント付き文字の構成を整えます。見た目が同じでも、保存されている文字の構成が異なる場合があります。"
          }
        }
      }
    },
    "ComposeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적으로 이 옵션을 사용하세요. 분리 저장된 문자를 가능한 경우 하나로 합칩니다. 예: ᄀ + ᅡ → 가, か + ゙ → が. 따로 입력된 ㄱㅏ 같은 호환 자모나 깨진 인코딩을 복원하는 기능은 아닙니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this for everyday names. Combines separately stored characters where possible, such as e + ◌́ → é. It does not repair corrupted text encoding or transliterate separately typed letters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常はこちらを使います。分離して保存された文字を、可能な場合に合成します。例：か + ゙ → が。文字化けや、別々に入力された互換字母の復元はできません。"
          }
        }
      }
    },
    "DecomposeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 도구가 분해형을 요구할 때만 사용하세요. 문자를 분리 저장하며, 화면에서는 같아 보일 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only when a tool requires decomposed text. Characters are stored as separate parts and may still look identical."
          }
