      }
    },
    "WatchHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감시 폴더에 새로 생기거나 바뀐 파일을 검토 목록에 모읍니다. 이름을 자동으로 바꾸지 않으며, ‘검토’를 누른 뒤 미리보기와 확인을 거쳐야 바뀝니다. 이미 처리한 파일은 앱을 다시 실행해도 다시 제안하지 않습니다. ‘현재 규칙으로 업데이트’를 누르면 폴더 전체를 다시 검토합니다. 감시 폴더와 하위 폴더 자체의 이름은 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New or changed files in a watched folder are collected for review. Nothing is renamed automatically: choose Review, then check the preview and confirm. Files you have already handled are not suggested again, even after you reopen the app. Choosing Use Current Rules reviews the whole folder again. Watched folders and their subfolders are never renamed themselves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視フォルダに追加されたファイルや変更されたファイルを、確認待ちとして集めます。名前を自動で変更することはありません。「確認」をクリックし、プレビューを確かめて実行したときにだけ変更します。処理済みのファイルは、アプリを開き直しても再び提案しません。ルールを更新すると、フォルダ全体を確認し直します。監視フォルダとそのサブフォルダ自体の名前は変更しません。"
          }
        }
      }
    },
    "WatchAdd": {
      "extractionState": "manual",
      "localizations": {
