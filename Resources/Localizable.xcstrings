          }
        }
      }
    },
    "ConflictHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 항목이 이미 있거나 여러 항목의 변경 후 이름이 같습니다. 덮어쓰지 않도록 이 항목은 이름 변경에서 제외합니다. 폴더에서 겹치는 이름을 정리한 뒤 다시 검사하거나 ‘충돌 이름에 번호 제안’을 사용하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If another item already has the new name, or several items would end up with the same name, the item is skipped and nothing is overwritten. Rename or move the duplicate in the folder, then rescan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前の項目がすでにあるか、複数の項目が同じ名前になります。この項目は変更しません。フォルダで重複を解消してから、再スキャンしてください。"
          }
        }
      }
    },
