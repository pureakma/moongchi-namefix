            "state": "translated",
            "value": "Clean, readable names. Your files stay the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすい名前に。ファイルの内容はそのまま。"
          }
        }
      }
    },
