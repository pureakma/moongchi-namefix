    "CloseAllHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 파일·폴더를 모두 닫고 처음 화면으로 돌아갑니다. 파일은 바뀌지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes everything you added and returns to the first screen. Your files are not changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したファイル・フォルダをすべて閉じて最初の画面に戻ります。ファイルは変更されません。"
          }
        }
      }
    },
    "OnbTitle1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀어지는 한글 파일 이름, 한 번에 해결"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix names that look broken on other devices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名の文字を、まとめて整える"
          }
        }
      }
    },
    "OnbBody1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 컴퓨터나 메신저로 보내면 ‘ㅎㅏㄴㄱㅡㄹ’처럼 풀어지는 파일 이름을 찾아, 보내기 전에 원래 글자로 합쳐 둡니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some names look fine on your Mac but show up on other devices with accents beside the letters or characters split apart, and may not match in search. NameFix finds them and fixes them before you share."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの環境とやり取りすると、濁点や半濁点が離れて見えたり、検索で見つからなかったりするファイル名があります。そうした名前を見つけて、受け渡す前に整えます。"
          }
        }
      }
    },
    "OnbPoint1A": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자소 분리, 일본어 탁점, 악센트 글자까지"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accented letters, Japanese kana, Korean Hangul, and more"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "濁点・半濁点、アクセント付きの文字、ハングルに対応"
          }
        }
      }
    },
    "OnbPoint1B": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 폴더를 창에 끌어다 놓기만 하면 검사"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just drop files or folders on the window"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやフォルダをウインドウにドロップするだけ"
          }
        }
      }
    },
    "OnbPoint1C": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 폴더 안까지 한 번에"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subfolders are scanned too"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブフォルダの中まで一度にスキャン"
          }
        }
      }
    },
    "OnbTitle2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾸기 전에 먼저 보여 드립니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see every change before it happens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更する前に、すべて確認できます"
          }
        }
      }
    },
    "OnbBody2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 전후 이름을 나란히 확인하고, 확인한 뒤에만 실제 이름을 바꿉니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current and new names are shown side by side. Nothing is renamed until you confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更前と変更後の名前を並べて表示します。確認して実行するまで、名前は変わりません。"
          }
        }
      }
    },
    "OnbPoint2A": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 바꾸고 파일 내용은 그대로"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only names change; file contents stay as they are"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変えるのは名前だけ。ファイルの内容はそのまま"
          }
        }
      }
    },
    "OnbPoint2B": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름이 이미 있으면 덮어쓰지 않고 제외"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never overwrites: conflicting names are skipped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前がある場合は上書きせずに除外"
          }
        }
      }
    },
    "OnbPoint2C": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 기록에서 원래 이름으로 되돌리기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the original names from History"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴から元の名前に戻せます"
          }
        }
      }
    },
    "OnbTitle3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 파일 이름을 규칙으로 한꺼번에"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename many files with simple rules"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のファイル名を、ルールでまとめて変更"
          }
        }
      }
    },
    "OnbBody3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 바꾸기, 번호 붙이기, 촬영 날짜 넣기 같은 규칙을 고르고 미리보기로 결과를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick rules such as replace text, add numbers or add the date taken, and check the result in the preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の置き換え、連番、撮影日の追加などのルールを選び、プレビューで結果を確認できます。"
          }
        }
      }
    },
    "OnbPoint3A": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 여러 개 쌓아서 한 번에 적용"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stack several rules and apply them together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のルールを組み合わせて一度に適用"
          }
        }
      }
    },
    "OnbPoint3B": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 규칙은 프리셋으로 저장"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the rules you use often as presets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うルールはプリセットとして保存"
          }
        }
      }
    },
    "OnbPoint3C": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 목록으로 새 이름을 직접 지정"
