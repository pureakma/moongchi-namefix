    "OnbTitle4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능이 무료, 처리는 이 Mac 안에서만"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is free, and stays on this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能が無料、処理はこのMacの中だけ"
          }
        }
      }
    },
    "OnbBody4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 만들 필요도, 로그인할 필요도 없습니다. 파일과 파일 이름은 어디로도 전송되지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account and no ads. Your files and their names are never sent anywhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも購入も不要です。ファイルやファイル名がどこかへ送信されることはありません。"
          }
        }
      }
    },
    "OnbPoint4A": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
