    "ReadyToScan": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 폴더를 추가하면 바로 검사합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add files or folders to start scanning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやフォルダーを追加すると検査を開始します。"
          }
        }
      }
    },
    "HelpBody": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일·폴더 추가 → 변경 전후 확인 → 이름 수정. 요약을 누르면 필터가 적용됩니다. 선택 버튼은 표시 항목에 적용되며 숨은 선택 수가 목록 위에 표시됩니다. ⌘O 파일 추가 · ⇧⌘O 폴더 추가 · ⌘F 검색 · ⌘R 다시 검사. 목록에서 ⌘A 표시 항목 선택. 작업 기록에서 되돌릴 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add files or folders → review names → fix names. Summary counts filter the list. Selection actions affect visible items; hidden selections are counted above the list. ⌘O add files · ⇧⌘O add folders · ⌘F search · ⌘R rescan. In the list, ⌘A selects visible items. Undo is available in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル・フォルダを追加 → 変更前後を確認 → 名前を修正。集計を押すと絞り込めます。選択操作は表示中の項目に適用され、非表示の選択数は一覧の上に表示されます。⌘O ファイル追加 · ⇧⌘O フォルダ追加 · ⌘F 検索 · ⌘R 再検査。一覧で⌘Aを押すと表示項目を選択します。履歴から元に戻せます。"
          }
        }
      }
    },
