        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These names look the same but store their characters differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目は同じですが、文字の構成が異なります。"
          }
        }
      }
    },
    "ClipboardTruncated": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
