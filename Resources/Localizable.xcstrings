    "WindowsNameNote": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows에서는 이 이름을 쓸 수 없습니다. 알려 드리기만 하며 자동으로 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows can’t use this name. This is a note only; the name is not changed automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はWindowsでは使えません。お知らせするだけで、自動では変更しません。"
          }
        }
      }
    },
    "WindowsReservedCharacter": {
