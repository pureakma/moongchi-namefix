    "MappingHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 형식의 CSV/TSV 파일에서 ‘현재 이름(또는 경로)’ 열과 ‘새 이름’ 열을 고릅니다. 이름이 중복되거나 어느 파일인지 분명하지 않은 행, 일치하는 파일이 없는 행이 있으면 이름을 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a UTF-8 CSV/TSV file, choose the column with the original names (or paths) and the column with the new names. Duplicate, ambiguous or unmatched rows block the rename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8のCSV/TSVファイルから、「元の名前（またはパス）」の列と「新しい名前」の列を選びます。重複している行、あいまいな行、一致しない行がある場合は実行しません。"
          }
        }
      }
    },
