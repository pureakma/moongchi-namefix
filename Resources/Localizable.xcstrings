    "OnbBody2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 전후 이름을 나란히 확인하고, 확인한 뒤에만 실제 이름을 바꿉니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current and new names are shown side by side. Nothing is renamed until you confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更前と変更後の名前を並べて確認し、確認したあとにだけ名前を変更します。"
          }
        }
      }
    },
    "OnbPoint2A": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 바꾸고 파일 내용은 그대로"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
