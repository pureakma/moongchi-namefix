    "MappingHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 형식의 CSV/TSV 파일에서 ‘원래 이름(또는 경로)’ 열과 ‘새 이름’ 열을 고릅니다. 중복되거나 모호한 이름, 일치하지 않는 행이 있으면 실행하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a UTF-8 CSV/TSV file, choose the column with the original names (or paths) and the column with the new names. Duplicate, ambiguous or unmatched rows block the rename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8のCSV/TSVファイルで「元の名前（またはパス）」の列と「新しい名前」の列を選びます。重複・あいまい・一致しない行があると実行しません。"
          }
        }
      }
    },
