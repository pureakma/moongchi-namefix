    "SafeExportHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시용 CSV는 수식으로 해석될 수 있는 셀 앞에 작은따옴표를 붙입니다. 원본 이름 bytes는 base64 열에 보존합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display CSV prefixes potentially executable cells with an apostrophe. Original name bytes are preserved in base64 columns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示用CSVは数式になり得るセルの先頭にアポストロフィを付けます。元の名前のバイト列はbase64列に保持します。"
          }
        }
      }
    },
    "RawExportHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 CSV는 이름을 그대로 저장합니다. 스프레드시트에서 열면 수식처럼 해석될 수 있으므로 텍스트로 가져오세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw CSV preserves names exactly. Import it as text in spreadsheet apps to avoid formula interpretation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の文字をそのまま保存します。数式として解釈されないよう、表計算アプリにはテキストとして読み込んでください。"
          }
        }
      }
    },
    "ExportFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기에 실패했습니다. 저장 위치의 권한과 여유 공간을 확인하세요."
          }
        },
        "en": {
