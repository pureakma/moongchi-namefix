    },
    "ChooseFolderToAllow": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 선택…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Folder…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択…"
          }
        }
      }
    },
    "RootNameExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 폴더 자체의 이름은 여기서 바꾸지 않습니다. 안에 있는 항목은 검사합니다. 이 폴더의 이름도 바꾸려면 한 단계 위의 폴더를 추가하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name of the folder you added is not changed here. The items inside it are scanned. To rename this folder too, add the folder that contains it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したフォルダ自体の名前はここでは変更しません。中の項目はスキャンします。このフォルダの名前も変更するには、1つ上のフォルダを追加してください。"
          }
        }
      }
    },
    "CheckForUpdates": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認"
          }
        }
      }
