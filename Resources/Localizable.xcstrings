            "state": "translated",
            "value": "Rename 1 item. File contents stay unchanged. Skipped: {1}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件の名前を変更します。ファイルの内容は変わりません。除外した項目：{1}件。"
          }
        }
      }
    },
    "TreePendingOne": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 이름 1개"
