    "CloseAllHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 파일·폴더를 모두 닫고 처음 화면으로 돌아갑니다. 파일은 바뀌지 않습니다."
          }
