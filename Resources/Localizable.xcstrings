            "state": "translated",
            "value": "アプリとパッケージは既定の検査対象から除外されます。"
          }
        }
      }
    },
    "MountBoundaryExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 디스크(볼륨) 안은 자동으로 검사하지 않습니다. 필요하면 직접 추가하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other disks (volumes) are not scanned automatically. Add one yourself if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のディスク（ボリューム）の中は自動では検査しません。必要な場合は直接追加してください。"
          }
        }
      }
    },
    "SourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 후 항목이 변경되어 제외했습니다. 다시 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item changed after scanning and was skipped. Scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査後に項目が変更されたため除外しました。再検査してください。"
          }
        }
      }
    },
    "SettingsSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장하지 못했습니다. 변경 사항은 현재 실행에만 적용됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be saved. Changes apply only to this session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存できませんでした。変更は今回の起動中のみ適用されます。"
          }
        }
      }
    },
    "NewerSchema": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 최신 버전의 데이터입니다. 원본을 보존하고 변경을 제한합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data was created by a newer version. The original is preserved and changes are restricted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンで作成されたデータです。元のデータを保護するため変更を制限します。"
          }
        }
      }
    },
    "BusyDropRejected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중에는 항목을 추가할 수 없습니다. 완료 후 다시 놓으세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items cannot be added during this operation. Drop them again when it finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中は項目を追加できません。完了後にもう一度ドロップしてください。"
          }
        }
      }
    },
    "SameAppearanceDifferentUnicode": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모양은 같지만 저장된 글자 구성이 다릅니다."
