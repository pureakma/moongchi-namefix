    },
    "ColumnWidthHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓은 창의 결과 표에 적용됩니다. 좁은 창에서는 두 이름을 세로로 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the results table in wide windows. Narrow windows show the two names vertically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが広いときの一覧に適用されます。狭いときは、2つの名前を上下に並べて表示します。"
          }
        }
      }
    },
    "CompletedWithErrors": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 항목을 변경하지 못했습니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items could not be renamed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目を変更できませんでした"
          }
        }
      }
    },
    "SourceChangedAfterMove": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 항목을 바꾼 것을 감지해 중단했습니다. 일부 항목이 임시 이름으로 남아 있을 수 있습니다. 작업 기록에서 위치를 확인하고 복구하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped because another app changed an item. One item may still have a temporary name. Check the recovery locations in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリによる変更を検出したため、停止しました。仮の名前のままの項目が残っている場合があります。履歴で項目の現在の場所を確認してください。"
          }
        }
      }
    },
    "RecoveryObservedPaths": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 항목이 발견된 위치입니다. 원래 파일과 같은 파일인지 확인하지 못해 자동으로 복구하지 않습니다. Finder에서 직접 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible locations. NameFix could not confirm that these are the same file, so it does not restore them automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかった場所です。元のファイルと同じものか確認できないため、自動では復元しません。"
          }
        }
      }
    },
    "RestoreOriginal": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 이름으로 복구"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Original Names"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の名前に戻す"
          }
        }
      }
    },
    "NoChangesExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목이 그사이 바뀌었거나 이름이 충돌해 안전을 위해 제외했습니다. 다시 검사한 뒤 상태와 경로를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected items have changed or have conflicts, so safety checks skipped them. Rescan, then review their status and paths."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目は、変更されたか競合しているため除外しました。再スキャンして、状態とパスを確認してください。"
          }
