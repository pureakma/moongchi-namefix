    "FavoriteUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 폴더를 열 수 없습니다. 폴더가 옮겨졌거나 삭제되었거나 접근 권한이 없습니다. 즐겨찾기에서 폴더를 다시 선택하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This favorite folder can’t be opened. It was moved, deleted, or you no longer have access. Choose the folder again from Favorites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このお気に入りフォルダを開けません。移動または削除されたか、アクセス権がありません。お気に入りからフォルダを選び直してください。"
          }
        }
      }
    },
    "FavoriteUnavailableShort": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 폴더를 열 수 없음"
