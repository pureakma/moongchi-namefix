            "state": "translated",
            "value": "{0}件の名前を変更します。ファイルの内容は変わりません。除外した項目：{1}件。"
          }
        }
      }
    },
    "CloudWarning": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화되는 폴더에서 이름을 바꾸면 다른 기기에도 반영될 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming inside a synced folder may also change the name on your other devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期フォルダ内の名前を変更すると、ほかのデバイスにも反映される場合があります。"
          }
        }
      }
    },
