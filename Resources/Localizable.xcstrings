    "LocalOnly": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 통신 없이 이 Mac에서 처리합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed on this Mac without network access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク通信を行わず、このMacで処理します。"
          }
        }
      }
    },
    "FilesystemHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 형식 디스크(Mac의 내장 디스크와 외장 APFS 드라이브)에 있는 항목만 이름을 바꿉니다. 앱, 링크, 클라우드 동기화 폴더, 네트워크 드라이브, exFAT·FAT 드라이브의 항목은 바꾸지 않고 보호합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only items on APFS disks (your Mac’s internal disk and external APFS drives) are renamed. Apps, links, cloud-synced folders, network drives, and exFAT or FAT drives are protected and left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS形式のディスク（Mac本体の内蔵ディスクと外付けのAPFSドライブ）にある項目だけ、名前を変更します。アプリ、リンク、クラウド同期フォルダ、ネットワークドライブ、exFAT・FATのドライブの項目は変更せずに保護します。"
          }
        }
      }
    },
    "InvalidPath": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 읽을 수 없는 경로입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This path cannot be read safely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に読み取れないパスです。"
          }
        }
      }
    },
