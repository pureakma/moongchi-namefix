    "DropHint": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일·폴더를\n끌어다 놓으세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files and folders here"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル・フォルダーをドロップ"
          }
        }
      }
    },
    "SafetyHint": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용은 수정하지 않습니다. 변경 전 이름을 미리 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File contents stay unchanged. Preview names before applying changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容は変更しません。実行前に名前を確認してください。"
          }
        }
      }
    },
