    "FilesystemHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 APFS 이름 변경을 지원합니다. 앱·링크·클라우드 및 확인되지 않은 볼륨은 보호합니다. 작업 중 다른 앱에서 같은 항목을 이동하거나 이름을 바꾸지 마세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local APFS renaming is supported. Apps, links, cloud locations and unverified volumes are protected. Do not move or rename the same items in other apps during an operation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルAPFSに対応します。アプリ、リンク、クラウド、未確認のボリュームは保護します。処理中に他のアプリで同じ項目を移動・改名しないでください。"
          }
        }
      }
    },
