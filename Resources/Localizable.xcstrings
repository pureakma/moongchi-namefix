    "StatusFolderNeeded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "— 폴더 선택 필요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "— Folder needed"
