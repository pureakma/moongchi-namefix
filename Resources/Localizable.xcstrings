    "FormatGuide": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 저장 형식 안내"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Character Forms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の保存形式について"
          }
        }
      }
    },
    "FormatIntro": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자소 분리, 일본어 탁점·반탁점, 악센트가 있는 글자 등 이름의 글자 구성을 정리합니다. 겉모양이 같아도 저장된 구성은 다를 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A character such as an accented letter, a Japanese kana with a voicing mark, or a Korean syllable can be stored whole or in pieces. Two names can look identical and still be stored differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の中の濁点・半濁点（が、ぱ など）、アクセント付きの文字（é など）、ハングルの表し方をそろえます。見た目が同じでも、保存されている形が異なることがあります。全角と半角の違いはこれとは別のもので、変換しません。"
          }
        }
      }
    },
    "ComposeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적으로 이 옵션을 사용하세요. 분리 저장된 글자를 가능한 경우 하나로 합칩니다. 예: ᄀ + ᅡ → 가, か + ゙ → が. 처음부터 낱자로 입력한 ㄱㅏ 같은 글자나 인코딩이 깨진 글자를 되살리는 기능은 아닙니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this for everyday names. Combines characters that are stored in pieces wherever possible, such as e + ◌́ → é. It does not repair garbled text from a wrong encoding, and it does not join letters that were typed as separate characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常はこちらを使います。分かれて保存されている文字を、可能な場合は1文字にまとめます。例：か + ゙ → が。半角カタカナ（ｶﾞ）、単独の濁点（゛）、別々に入力されたハングル字母（ㄱㅏ）などは対象外です。文字化けを直す機能ではありません。"
          }
        }
      }
    },
    "DecomposeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 프로그램이 분리된 형식을 요구할 때만 사용하세요. 글자를 나누어 저장하며, 화면에서는 같아 보일 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this only when another tool requires the split form. Characters are stored in pieces and may still look identical."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのツールが分離形式を必要とする場合にだけ使います。文字を分けて保存しますが、見た目は変わらない場合があります。"
          }
        }
      }
    },
    "KeepFormHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 변경 규칙만 적용하고 글자 저장 형식은 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply naming rules without changing the character form."
