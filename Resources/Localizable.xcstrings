    "EmptyDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 폴더를 이 창에 놓으세요. 이름의 자소 분리를 검사하고, 변경 내용을 확인한 뒤 합칠 수 있습니다. 파일 내용은 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files or folders anywhere in this window. Check separated characters and review the names before combining them. File contents stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやフォルダをこのウインドウにドロップ。濁点などが分離した名前を検査し、変更内容を確認してから合成できます。ファイルの内容は変更しません。"
          }
        }
      }
    },
    "WorkspaceSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
