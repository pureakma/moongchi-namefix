    "TargetsHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본으로는 보이는 일반 파일의 이름만 바꿉니다. 하위 폴더 안의 파일은 포함하지만 폴더 이름과 숨김 항목은 그대로 둡니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default only the names of visible, regular files change. Files inside subfolders are included; folder names and hidden items are left as they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、表示されている通常のファイルの名前だけを変更します。サブフォルダ内のファイルは含みますが、フォルダ名と非表示の項目はそのままです。"
          }
        }
      }
    },
