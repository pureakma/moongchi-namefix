      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본으로 꺼져 있습니다. 폴더 경로를 최대 10개까지 이 Mac에 저장하며, 끄면 저장된 목록을 지웁니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Stores up to 10 folder paths locally. Turning this off clears the saved list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではオフです。フォルダのパスを最大10件、このMacに保存します。オフにすると、保存した一覧を消去します。"
          }
        }
      }
    },
    "ChangeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상된 것은 아닙니다. 분리 저장된 글자를 하나로 합칠 수 있으며 파일 내용은 바뀌지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is wrong with the file. Some characters in its name are stored in pieces (or in another nonstandard way), which can look broken or fail to match on other devices. Fixing stores them in the standard form; file contents stay the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが壊れているわけではありません。分かれて保存されている文字を1文字にまとめられます。ファイルの内容は変わりません。"
          }
        }
      }
    },
