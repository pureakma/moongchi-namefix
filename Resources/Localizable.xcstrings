    "ManualOrderHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 항목을 끌어 순서를 바꿉니다. 검색·표 정렬은 번호에 영향을 주지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag rows to reorder. Search and table sorting do not affect numbering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧の行をドラッグして順序を変えます。検索や一覧の並べ替えは、連番に影響しません。"
          }
        }
      }
    },
    "PairExtensions": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 바꿀 확장자 (예: jpg,raw,xmp)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensions to rename together (e.g. jpg,raw,xmp)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に変更する拡張子（例：jpg,raw,xmp）"
          }
        }
      }
    },
    "PairHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 폴더에서 이름이 같고 확장자만 다른 파일(예: 사진의 jpg와 raw)을 한 묶음으로 보고 같은 새 이름과 번호를 붙입니다. 확장자는 그대로 둡니다. ‘확장자 제외 이름’에 적용하는 규칙만 쓸 수 있고 CSV 목록과는 함께 쓸 수 없습니다. 묶음 중 일부만 선택했거나 충돌·오류가 있으면 묶음 전체를 제외합니다. 일부만 바뀐 경우 작업 기록에서 복구할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in one folder that share a name and differ only by extension (such as a photo’s jpg and raw) are treated as a set and get the same new name and number. Extensions are kept. Only rules that apply to the name without extension can be used, and a CSV list cannot be used at the same time. A set is skipped if only part of it is selected or if it has a conflict or error. Partly renamed sets can be recovered in History."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じフォルダにあり、名前が同じで拡張子だけが異なるファイル（例：写真のjpgとraw）を1つのセットとして扱い、同じ新しい名前と連番を付けます。拡張子はそのままです。使用できるのは「拡張子を除く名前」に適用するルールだけで、CSVリストとは併用できません。セットの一部だけを選択した場合や、競合・エラーがある場合は、セット全体を除外します。一部だけ変更された場合は、履歴から復旧できます。"
          }
        }
      }
    },
    "PairAmbiguous": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음 파일 중 일부가 모호하거나 충돌합니다. 묶음 전체를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of a file set is ambiguous or conflicting. Review the whole set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットのファイルの一部があいまいか、競合しています。セット全体を確認してください。"
          }
        }
      }
    },
