    "ConfirmBodyOne": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1개 항목의 이름을 바꿉니다. 파일 내용은 바뀌지 않습니다. 제외: {1}개."
          }
        },
        "en": {
