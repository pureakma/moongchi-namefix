    "ManualOrderHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 드래그하여 순서를 바꿉니다. 검색·표 정렬은 순번에 영향을 주지 않습니다."
          }
        },
        "en": {
