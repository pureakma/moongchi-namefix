    },
    "MetadataHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터는 해당 규칙을 켠 파일만 읽습니다. JPEG/TIFF/HEIC, MP3/M4A, MOV/MP4, PDF 필드를 지원하며 없는 필드는 제외하거나 지정한 대체 텍스트를 씁니다. 시간대는 UTC, Asia/Seoul 또는 source(원본 오프셋; 없으면 UTC)입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata is read only for enabled rules. Fields support JPEG/TIFF/HEIC, MP3/M4A, MOV/MP4 and PDF. Missing values exclude the item unless fallback text is specified. Use UTC, Asia/Seoul or source (original offset, UTC if absent)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータは有効な規則でのみ読み取ります。JPEG/TIFF/HEIC、MP3/M4A、MOV/MP4、PDFに対応し、欠落値は除外または指定テキストを使用します。時間帯はUTC、Asia/Seoul、source（元のオフセット、未記録はUTC）です。"
          }
        }
      }
    },
    "DateFormat": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 형식 (예: yyyy-MM-dd)"
          }
        },
        "en": {
