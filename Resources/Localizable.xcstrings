    "JournalWriteFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 기록을 저장하지 못해 이름 변경을 중단했습니다. 디스크 여유 공간을 확인한 뒤 다시 시도하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming stopped because the operation record could not be saved. Check free disk space and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業記録を保存できなかったため、名前の変更を停止しました。ディスクの空き容量を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "RecoveryNeedsReview": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 작업의 상태를 확인해야 합니다. 파일과 기록은 보존되었습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous operation needs review. Files and records have been preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の作業状態を確認する必要があります。ファイルと記録は保持されています。"
          }
        }
      }
    },
    "CanonicalVariant": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "● 글자 구성 다름"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "● Different composition"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "● 構成が異なる"
          }
        }
      }
    },
    "NormalizationNotice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉모양은 같아도 저장된 글자 구성이 다를 수 있습니다. 글자가 분리 저장된 이름은 오류가 아니며, 하나로 합쳐 통일할 수 있습니다. 작은 칸은 실제 이름이 아니라 글자 구성을 풀어 보여 주는 설명입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can look identical while storing their characters differently. Separated names are not errors; they can be combined into one consistent form. The small boxes explain the characters and are not part of the name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目が同じでも、保存されている文字の構成が異なることがあります。文字が分離した名前はエラーではなく、合成して統一できます。小さな枠は実際の名前ではなく、文字構成の説明です。"
          }
        }
      }
    },
    "CompositionTitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 문자 구성 비교"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full character comparison"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文字構成を比較"
          }
        }
      }
    },
    "CompositionLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 칸은 내부 문자를 풀어 쓴 설명입니다. 파일명 자체에 공백이나 구분 기호를 추가하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boxes explain individual characters. No spaces or separators are added to the actual filename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠は内部の文字を分けた説明です。実際のファイル名に空白や区切り文字は追加しません。"
          }
        }
      }
    },
    "CompositionScalarLegend": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 자모는 읽기 쉬운 낱자 모양으로, 결합 부호는 점선 원과 함께 표시합니다. U+로 시작하는 값은 실제 문자의 코드입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangul letters are shown as standalone shapes and combining marks with a dotted circle. Values starting with U+ are the actual character codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハングル字母は独立した形で、結合記号は点線の丸とともに表示します。U+で始まる値は実際の文字コードです。"
          }
        }
      }
    },
    "MoreCharacterChanges": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 {0}개 글자도 달라집니다. 상세 보기에서 전체 구성을 확인하세요."
