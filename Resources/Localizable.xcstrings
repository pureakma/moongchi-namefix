        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査をキャンセルしました。検査済みの項目を表示します。"
          }
        }
      }
    },
    "ScanLimit": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 한도인 200,000개에 도달했습니다. 폴더를 나누어 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 200,000 item safety limit was reached. Scan smaller folders separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全上の上限20万件に達しました。フォルダを分けて検査してください。"
          }
        }
      }
    },
    "SettingsWarning": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 읽을 수 없어 기본값을 사용합니다. 원본 설정 파일은 보존됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be loaded. Safe defaults are active; the original file is preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めないため既定値を使用します。元のファイルは保持されます。"
          }
        }
      }
    },
    "CancelBeforeClose": {
      "extractionState": "manual",
      "localizations": {
