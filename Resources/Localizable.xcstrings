          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視の設定を読み込めないか、保存できません。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "WatchRescan": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 변경을 놓쳤거나 폴더가 바뀌었습니다. ‘검토’를 눌러 전체를 다시 확인하세요."
