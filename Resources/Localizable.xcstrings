    "FilesystemHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 내장 디스크(APFS)에 있는 항목만 바꿉니다. 앱, 링크, 클라우드 폴더, 확인되지 않은 디스크의 항목은 바꾸지 않고 보호합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only items on this Mac's internal disk (APFS) are renamed. Apps, links, cloud folders and unverified disks are protected and left unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの内蔵ディスク（APFS）にある項目だけを変更します。アプリ、リンク、クラウドフォルダ、未確認のディスクの項目は変更せずに保護します。"
          }
        }
      }
    },
