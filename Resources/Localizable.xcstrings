    "MappingReadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 읽지 못했습니다. UTF-8 형식과 열 구성을 확인하세요."
          }
