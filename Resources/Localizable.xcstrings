      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 수 있는 이름이 없습니다. 다시 검사해 미리보기를 업데이트하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No safe changes remain. Rescan to refresh the preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更できる項目がありません。再スキャンしてプレビューを更新してください。"
          }
        }
      }
    },
    "NoHistory": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 작업 기록이 없습니다."
