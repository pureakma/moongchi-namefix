          }
        }
      }
    },
    "ConfirmRecoveryOne": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 이름으로 복구할 1개 항목을 확인하세요. 확인한 뒤에만 복구합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review 1 item to restore to its original name. Nothing changes until you confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の名前に戻す1件を確認してください。確認するまで、何も変更しません。"
          }
        }
      }
    },
    "UndoConfirmOne": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1개 항목을 원래 이름으로 되돌립니다. 되돌릴 수 없는 {1}개는 제외합니다. 이름이 충돌하거나, 작업 이후 교체되거나 이동된 항목이 여기에 해당합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore 1 original name; {1} will be skipped. Items that conflict, or that were moved or replaced since the operation, are skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件を元の名前に戻します。戻せない{1}件は除外します。名前が競合する項目や、操作のあとに置き換えまたは移動された項目が該当します。"
          }
        }
      }
    },
    "FolderAccessNeeded": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목의 이름을 확인하고 바꾸려면 항목이 들어 있는 폴더를 선택해 주세요. macOS는 사용자가 고른 폴더 안에서만 앱이 이름을 바꿀 수 있게 합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To check and rename this item, choose the folder that contains it. macOS lets the app rename items only inside a folder you have chosen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目の名前を確認して変更するには、項目が入っているフォルダを選択してください。macOSでは、選択したフォルダの中でのみ、アプリが名前を変更できます。"
          }
        }
      }
    },
    "FolderAccessNeededShort": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 선택 필요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder to continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダの選択が必要です"
          }
        }
      }
    },
    "FolderAccessMessage": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘{0}’ 폴더를 선택하면 그 안의 이름을 확인하고 바꿀 수 있습니다. 파일 내용은 바꾸지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the “{0}” folder to check and rename the names inside it. File contents are never changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{0}」フォルダを選択すると、その中の名前を確認して変更できます。ファイルの内容は変更しません。"
          }
        }
      }
    },
    "UndoFolderMessage": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 되돌리려면 ‘{0}’ 폴더를 다시 선택해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To undo this operation, choose the “{0}” folder again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を元に戻すには、「{0}」フォルダをもう一度選択してください。"
          }
        }
      }
    },
    "UndoNeedsFolder": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 되돌리려면 해당 폴더를 다시 선택해야 합니다. 작업 기록에서 되돌리기를 다시 누르면 폴더를 고를 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To undo this operation, its folder has to be chosen again. Choose Undo in History once more to pick the folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を元に戻すには、フォルダをもう一度選択する必要があります。履歴で「元に戻す」をもう一度選ぶと、フォルダを選択できます。"
          }
        }
      }
    },
    "UndoNeedsFolderShort": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌리려면 폴더를 다시 선택"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder again to undo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すにはフォルダの再選択が必要です"
          }
        }
      }
    },
    "AllowFolder": {
      "extractionState": "manual",
      "localizations": {
