    "OperationError": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료하지 못했습니다. 작업 기록과 로컬 진단 로그를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not finish. Check History and local diagnostic logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理を完了できませんでした。履歴とローカルログを確認してください。"
          }
        }
      }
    },
    "Cancelled": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사를 취소했습니다. 완료된 항목만 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan cancelled. Partial results are shown."
