    "RecentUnavailableShort": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 폴더를 찾을 수 없음"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent folder not found"
          }
        },
