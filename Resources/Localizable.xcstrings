    "FileCoordinationFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 파일 작업이 끝나기를 기다렸지만 접근할 수 없습니다. 해당 앱의 저장·이동을 마친 뒤 다시 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is still using these files. Finish saving or moving them in that app, then rescan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリがファイルを使用しているため、アクセスできませんでした。そのアプリでの保存や移動が終わってから、再スキャンしてください。"
          }
        }
      }
    },
    "ConcurrentChangeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업하는 동안 다른 앱에서 같은 항목을 저장하거나 옮기지 마세요. 외부 변경을 감지하면 바로 멈추며, 이미 옮겨진 항목의 위치는 작업 기록에서 확인할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not save or move the same items in another app during the operation. If an outside change is detected the operation stops, and History shows where any moved item is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中は、ほかのアプリで同じ項目を保存したり移動したりしないでください。ほかのアプリによる変更を検出すると、すぐに停止します。すでに移動した項目の場所は、履歴で確認できます。"
          }
        }
      }
    },
    "ShowInFinder": {
      "extractionState": "manual",
