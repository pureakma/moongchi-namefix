        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンで作成されたデータです。元のデータを保護するため変更を制限します。"
          }
        }
      }
    },
    "BusyDropRejected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중에는 항목을 추가할 수 없습니다. 완료 후 다시 놓으세요."
