    "OnbBody3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 바꾸기, 번호 붙이기, 촬영 날짜 넣기 같은 규칙을 고르고 미리보기로 결과를 확인하세요."
          }
        },
