    "FileCoordinationFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 파일 작업이 끝나기를 기다렸지만 접근할 수 없습니다. 해당 앱의 저장·이동을 마친 뒤 다시 검사하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not coordinate access with another app. Finish saving or moving the files in that app, then scan again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリとのファイルアクセス調整が完了しませんでした。保存・移動を終えてから再検査してください。"
          }
        }
      }
    },
    "ConcurrentChangeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 같은 항목을 저장·이동하는 동안에는 작업을 피하세요. 외부 변경을 감지하면 중단하며, 이동된 항목은 작업 기록에서 위치를 확인할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid renaming items while another app is saving or moving them. Detected external changes stop the operation; check History for the location of any moved items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリが同じ項目を保存・移動している間は操作を避けてください。外部変更を検出すると停止します。移動した項目の場所は履歴で確認できます。"
          }
        }
      }
    },
