      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행할 수 있는 변경이 없습니다. 다시 검사해 미리보기를 갱신하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No safe changes remain. Rescan to refresh the preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行できる変更はありません。再検査してください。"
          }
        }
      }
    },
    "NoHistory": {
      "extractionState": "manual",
      "localizations": {
