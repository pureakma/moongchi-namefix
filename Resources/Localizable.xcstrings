      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 접근 권한이 만료되었거나 위치가 바뀌었습니다. 기존 항목을 제거하고 폴더를 다시 선택하세요."
          }
