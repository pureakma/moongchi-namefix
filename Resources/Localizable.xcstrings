          "stringUnit": {
            "state": "translated",
            "value": "コピーした文字を貼り付けて合成または分離し、結果をコピーします。ファイルは変更しません。"
          }
        }
      }
    },
    "WatchToolDetail": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 폴더에 새로 생긴 파일을 모아 두었다가 확인 후 이름을 바꿉니다."
          }
        },
        "en": {
