    "ConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}개 항목의 이름을 바꿉니다. 파일 내용은 바뀌지 않습니다. 제외: {1}개."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename {0} items. File contents stay unchanged. Excluded: {1}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}件の名前を変更します。ファイルの内容は変わりません。除外: {1}件。"
          }
        }
      }
    },
    "CloudWarning": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화되는 폴더에서 이름을 바꾸면 다른 기기에도 반영될 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming inside a synced folder may also change the name on your other devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期フォルダでの変更は他のデバイスにも反映される場合があります。"
          }
        }
      }
    },
